{
  "name": "proroute",
  "version": "1.0.0",
  "private": true,
  "description": "Healthcare Appointment Platform with Constrained AI Intake, Secure Scheduling, Payments, and Real-Time Chat",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev:server": "npm run dev --workspace=server",
    "dev:client": "npm run dev --workspace=client",
    "dev": "npm run dev --workspace=server",
    "build": "npm run build --workspaces --if-present",
    "build:server": "npm run build --workspace=server",
    "build:client": "npm run build --workspace=client",
    "test": "npm run test --workspaces --if-present",
    "test:server": "npm run test --workspace=server",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "npm run lint --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [
    "healthcare",
    "appointments",
    "telehealth",
    "express",
    "react",
    "prisma",
    "postgresql",
    "typescript"
  ],
  "author": "Muhammad Ahsan Khan",
  "license": "ISC",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "prettier": "^3.9.9",
    "typescript-eslint": "^8.71.0"
  }
}
