# Database connection (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/proroute?schema=public"

# Server configuration
PORT=5000
NODE_ENV=development

# JWT Authentication Secrets
JWT_ACCESS_SECRET="super-secret-access-key-change-in-production-min-32-chars-long"
JWT_REFRESH_SECRET="super-secret-refresh-key-change-in-production-min-32-chars-long"

# CORS Origin
CORS_ORIGIN="http://localhost:5173"

# Google OAuth 2.0 Client ID
GOOGLE_CLIENT_ID="mock-google-client-id.apps.google"

# Real-Time Email Dispatch (Resend Recommended / SendGrid alternative)
RESEND_API_KEY="re_your_resend_api_key_here"
# SENDGRID_API_KEY="SG.your_sendgrid_api_key_here"
SMTP_FROM="ProRoute Health <onboarding@resend.dev>"


